# 留空数据库时，开发环境使用明确标记的本地 JSON 演示存储。
DATABASE_URL=
DATA_ENCRYPTION_KEY=
# 生产环境必须配置数据库，或显式开启演示模式。
DEMO_MODE=true
DEMO_DATA_PATH=.demo-data/store.json
# 仅本机使用时设为 true；接口将拒绝非 localhost 访问，且禁止连接远程 PostgreSQL。
LOCAL_PRIVATE_MODE=false
# 仅用于本机加密数据文件。至少 32 个随机字符；真实值只能放在被 Git 忽略的 .env.local。
LOCAL_DATA_KEY=
# 缺密钥使用规则演示评分；不会伪称 AI 已调用。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
APP_ORIGIN=http://localhost:3000
# 反向代理有可信且覆盖写入的 X-Forwarded-For 时才设为 true。
TRUST_PROXY=false

